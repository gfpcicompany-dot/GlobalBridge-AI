# ══════════════════════════════════════════════════════════
# GlobalBridge AI Platform - Environment Variables
# ══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════

# JWT Secret for session signing (required for login)
JWT_SECRET=globalbridge-dev-secret-2026

# Database (MySQL) — leave empty to use demo data
DATABASE_URL=

# OAuth (optional — not needed for demo)
OAUTH_SERVER_URL=
VITE_APP_ID=

# Owner (optional)
OWNER_OPEN_ID=

# AI / LLM (optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=
